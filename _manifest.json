{
  "manifest_version": 2,
  "id": "com.na2cr2o7.qqpilot",
  "version": "2.3.0",
  "name": "QQPilot 适配器",
  "description": "把 QQPilot 的 OpenAI ChatCompletion 请求接入 MaiBot，支持文本、图片、表情包、会话归类与消息去重。",
  "author": {
    "name": "Na2Cr2O7",
    "url": "https://example.com"
  },
  "license": "CC-BY",
  "urls": {
    "repository": "https://example.com",
    "homepage": "https://example.com",
    "documentation": "https://example.com",
    "issues": "https://example.com"
  },
  "plugin_type": "adapter",
  "display": {
    "icon": {
      "type": "local",
      "value": "Icon.png"
    }
  },
  "changelog": "CHANGELOG.md",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.10.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "pillow",
      "version_spec": ">=10.0.0,<14"
    }
  ],
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "_locales",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
